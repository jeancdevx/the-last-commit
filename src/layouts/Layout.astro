---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'The Last Commit',
  description = 'El sistema dice que la oficina está vacía. Tú sigues dentro. Terror narrativo 3D en primera persona.'
} = Astro.props

const rawBase = import.meta.env.BASE_URL || '/'
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`
const asset = (path: string) => `${base}assets/${path.replace(/^\/+/, '')}`
---

<!doctype html>
<html lang='es' class='h-full bg-tlc-bg text-tlc-text'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='description' content={description} />
    <meta name='theme-color' content='#111716' />
    <meta property='og:type' content='website' />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:image' content={asset('art/social-1200x630.jpg')} />
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content={asset('art/social-1200x630.jpg')} />
    <link rel='icon' href={asset('branding/favicon.ico')} sizes='any' />
    <link rel='icon' type='image/png' href={asset('branding/favicon.png')} />
    <link
      rel='apple-touch-icon'
      href={asset('branding/apple-touch-icon.png')}
    />
    <link rel='stylesheet' href={asset('branding/theme.css')} />
    <title>{title}</title>
  </head>
  <body class='h-full overflow-hidden bg-tlc-bg font-body text-tlc-text'>
    <slot />
  </body>
</html>
